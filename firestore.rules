rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-deny catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to verify if the user belongs to the specified store
    function belongsToStore(storeId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId == storeId;
    }

    // Helper function to verify if the user is a system admin
    function isSysAdmin() {
      return isSignedIn() && 
        request.auth.token.email != null && 
        request.auth.token.email.toLowerCase() == 'phancamquyen1996@gmail.com';
    }

    // Helper function to verify if the user can access store-specific data
    function canAccessStore(storeId) {
      return isSysAdmin() || belongsToStore(storeId);
    }

    // Helper function to check if current user is Store Admin (Owner)
    function isStoreAdmin(storeId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId == storeId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // Helper function to check if current user is Store Manager
    function isStoreManager(storeId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId == storeId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isSysAdmin());
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isSysAdmin() || 
        (resource != null && 'storeId' in resource.data && canAccessStore(resource.data.storeId))
      );
      allow update, delete: if isSignedIn() && (
        request.auth.uid == userId || 
        isSysAdmin() || 
        (resource != null && 'storeId' in resource.data && (isStoreAdmin(resource.data.storeId) || isStoreManager(resource.data.storeId)))
      );
    }

    // --- Stores Collection ---
    match /stores/{storeId} {
      allow list: if isSysAdmin();
      // Allow creation during registration when the user profile doesn't exist yet
      allow create: if isSignedIn();
      allow read, update, delete: if canAccessStore(storeId);

      // --- Subcollection: Products ---
      match /products/{productId} {
        allow read, write: if canAccessStore(storeId);
      }

      // --- Subcollection: Ingredients ---
      match /ingredients/{ingredientId} {
        allow read, write: if canAccessStore(storeId);
      }

      // --- Subcollection: Batches ---
      match /batches/{batchId} {
        allow read, write: if canAccessStore(storeId);
      }

      // --- Subcollection: Orders ---
      match /orders/{orderId} {
        allow read, write: if canAccessStore(storeId);
      }

      // --- Subcollection: Suppliers ---
      match /suppliers/{supplierId} {
        allow read, write: if canAccessStore(storeId);
      }

      // --- Subcollection: Inventory Transactions ---
      match /inventoryTransactions/{transactionId} {
        allow read, write: if canAccessStore(storeId);
      }

      // --- Subcollection: Transactions ---
      match /transactions/{transactionId} {
        allow read, write: if canAccessStore(storeId);
      }

      // --- Subcollection: Customers ---
      match /customers/{customerId} {
        allow read, write: if canAccessStore(storeId);
      }

      // --- Subcollection: Tables ---
      match /tables/{tableId} {
        allow read, write: if canAccessStore(storeId);
      }

      // --- Subcollection: Zones ---
      match /zones/{zoneId} {
        allow read, write: if canAccessStore(storeId);
      }

      // --- Subcollection: Kitchen Items ---
      match /kitchenItems/{kitchenItemId} {
        allow read, write: if canAccessStore(storeId);
      }

      // --- Subcollection: Attendance ---
      match /attendance/{attendanceId} {
        allow read, write: if canAccessStore(storeId);
      }

      // --- Subcollection: Logs ---
      match /logs/{logId} {
        allow read, write: if canAccessStore(storeId);
      }
    }
  }
}
