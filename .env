# Real secrets for docker-compose.yml. Never commit this file.

# Secret stored in the app (browser) to call the SQL API.
API_TOKEN=fa4946841648cf163e2dfda945aee60264bc72584c45463a

# Secret for the admin page (/admin/db). Different from API_TOKEN.
ADMIN_TOKEN=79ad8bba5e66d7bc8358224dfc83952d75d2d217de3effe5

# Folder on this machine that holds pos.db and backups/. Use forward slashes on Windows.
#   Windows example: D:/mvp-pos-data
POS_DATA_DIR=./data

# Local port the container listens on (Apache forwards to it).
POS_PORT=8790

# Who may connect to POS_PORT. 0.0.0.0 = also devices in the shop network (needed for POS_LAN_ADDRESS).
POS_BIND_ADDRESS=0.0.0.0

# Routes to this server, built into the web app. Domain first, then the LAN address of this machine.
# They also fill CORS_ORIGIN. To build on another machine without pointing at production:
#   POS_DOMAIN_URL= POS_LAN_ADDRESS= docker compose up -d --build
POS_DOMAIN_URL=https://pos.hp-backup.com
POS_LAN_ADDRESS=192.168.1.19
