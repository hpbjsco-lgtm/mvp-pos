# Copy to .env (next to docker-compose.yml) and fill in. Never commit the real .env file.

# Secret stored in the app (browser) to call the SQL API. At least 16 characters.
API_TOKEN=change-me-api-token-0123456789

# Secret for the admin page (/admin/db). At least 16 characters and different from API_TOKEN.
ADMIN_TOKEN=change-me-admin-token-0123456789

# Folder on this machine that holds pos.db and backups/. Use forward slashes on Windows.
#   Windows example: D:/mvp-pos-data
POS_DATA_DIR=./data

# Local port the container listens on (Apache forwards to it).
POS_PORT=8790

# Who may connect to that port. 127.0.0.1 = this machine only (Apache). Use 0.0.0.0 to also accept devices
# in the shop network (needed when POS_LAN_ADDRESS is set).
POS_BIND_ADDRESS=127.0.0.1

# Routes to this server, fixed into the web app when the image is built. The domain is tried first; when it
# cannot be reached the app uses the LAN address. Write each once, without /api. They also fill CORS_ORIGIN.
#   POS_DOMAIN_URL  = how the internet reaches this server (empty = the address the app is served from)
#   POS_LAN_ADDRESS = the LAN address of THIS machine, without port or http:// (empty = no local route); the
#                     local address becomes http://<POS_LAN_ADDRESS>:<POS_PORT>
#POS_DOMAIN_URL=https://pos.hp-backup.com
#POS_LAN_ADDRESS=192.168.1.12

# Scheduled backups into <POS_DATA_DIR>/backups. Hours between backups (0 = off) and how many copies to keep.
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP=14

# Mail server used to send "forgot password" codes. Leave SMTP_HOST empty to turn the feature off (the app then
# hides the "Quên mật khẩu?" link). Port 587 uses STARTTLS, port 465 uses TLS. Never commit the real password.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=no-reply@example.com
#SMTP_PASS=change-me
#SMTP_FROM=MVP POS <no-reply@example.com>

