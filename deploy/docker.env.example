# Copy to .env (next to docker-compose.yml) and fill in. Never commit the real .env file.

# Secret stored in the app (browser) to call the SQL API. At least 16 characters.
API_TOKEN=change-me-api-token-0123456789

# Secret for the admin page (/admin/db). At least 16 characters and different from API_TOKEN.
ADMIN_TOKEN=change-me-admin-token-0123456789

# Folder on this machine that holds pos.db and backups/. Use forward slashes on Windows.
#   Windows example: D:/mvp-pos-data
POS_DATA_DIR=./data

# Local port the container listens on (Apache forwards to it).
POS_PORT=8790

# Who may connect to that port. 127.0.0.1 = this machine only (Apache). Use 0.0.0.0 to also accept devices
# in the shop network, which then use http://<LAN address of this machine>:<POS_PORT> as VITE_SERVER_LOCAL_URL.
POS_BIND_ADDRESS=127.0.0.1

# Scheduled backups into <POS_DATA_DIR>/backups. Hours between backups (0 = off) and how many copies to keep.
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP=14

# Routes to this server, fixed into the web app when the image is built.
# The domain is tried first; when it cannot be reached the app switches to the local address.
# Both may be written with or without a trailing /api.
#VITE_SERVER_DOMAIN_URL=https://pos.hp-backup.com
#VITE_SERVER_LOCAL_URL=http://192.168.1.12:8790

# Web pages or phone apps served from another address than the one they call must be listed here
# (comma-separated). Example: the web app opened at http://192.168.1.12:8790 calls https://pos.hp-backup.com,
# and the phone apps run on https://localhost (Android) or capacitor://localhost (iOS).
#CORS_ORIGIN=http://192.168.1.12:8790,https://pos.hp-backup.com,https://localhost,capacitor://localhost
